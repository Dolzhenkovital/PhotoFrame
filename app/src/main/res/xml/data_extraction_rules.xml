<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ twin of backup_rules.xml: exclude the OAuth token store from
     both cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="gphotos_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="gphotos_auth.xml" />
    </device-transfer>
</data-extraction-rules>
