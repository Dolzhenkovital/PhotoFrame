<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage permissions: the local source uses SAF folder access,
         which needs none on any supported API level (local-photos skill).
         INTERNET is for the Google Photos Picker API only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PhotoFrameApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoFrame">

        <!-- configChanges: the slideshow must survive rotation without an
             Activity restart (we only swap the photo-selection bucket). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PhotoFrame.Settings" />
    </application>

</manifest>
