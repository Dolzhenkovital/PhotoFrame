<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The primary local source is a SAF folder pick, which needs no
         storage permission on any supported API level (local-photos skill).
         INTERNET is for the Google Photos Picker API only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Device-gallery (MediaStore) source — the fallback for frames whose
         SAF provider is broken at the firmware level (see
         MediaStoreScanner). Permission matrix from the local-photos skill:
         READ_EXTERNAL_STORAGE up to API 32, READ_MEDIA_IMAGES from 33, and
         VISUAL_USER_SELECTED so API 34+ partial grants are honored silently
         instead of re-prompting. Requested at runtime only when the user
         actually picks the gallery source. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Backup stays on, but the OAuth token store is excluded on every
         API level — a restored backup must not carry Google credentials. -->
    <application
        android:name=".PhotoFrameApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoFrame">

        <!-- configChanges: the slideshow must survive rotation without an
             Activity restart (we only swap the photo-selection bucket). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PhotoFrame.Settings" />
    </application>

</manifest>
